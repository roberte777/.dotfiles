PUID=1000
PGID=1000
TZ=America/Chicago

DATA_DIR=/data
APPDATA_DIR=/docker/appdata

# ProtonVPN WireGuard key (you must fill this)
# Get it from: https://account.protonvpn.com -> Downloads -> WireGuard configuration
# Generate a config, then copy the PrivateKey value out of the [Interface] section.
#
# Generate the certificate with NAT-PMP (Port Forwarding) ENABLED -- it is baked
# into the cert and cannot be turned on afterwards without issuing a new one.
WIREGUARD_PRIVATE_KEY=REPLACE_ME
SERVER_COUNTRIES=United States

# MouseHole -- keeps the MyAnonaMouse session IP in sync with the VPN exit.
# Password for the MouseHole web UI on port 5010. Use a long random string.
MOUSEHOLE_AUTH_PASSWORD=REPLACE_ME
# Host header allowlist; required when reaching the UI over the LAN rather than
# localhost. Set to the host:port combinations you actually browse to.
MOUSEHOLE_ALLOWED_HOSTS=192.168.1.100:5010,localhost:5010,127.0.0.1:5010

# Homarr encryption key (64-char hex string)
# Generate with: ./generate-homarr-key.sh
HOMARR_SECRET_ENCRYPTION_KEY=REPLACE_ME

# Omnibus public URL - must match the URL you use in your browser
# Example: http://192.168.1.100:3000 or https://omnibus.yourdomain.com
OMNIBUS_PUBLIC_ORIGIN=http://localhost:3000

# Vaultwarden domain - the URL you access Vaultwarden from (required for WebAuthn/attachments)
# Example: http://192.168.1.100:8083 or https://vault.yourdomain.com
VAULTWARDEN_DOMAIN=http://localhost:8083
# Set to true only while creating your account, then set back to false
VAULTWARDEN_SIGNUPS_ALLOWED=false
